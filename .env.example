# --- Postgres ---
POSTGRES_USER=liveshortly
POSTGRES_PASSWORD=liveshortly
POSTGRES_DB=liveshortly
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- API ---
API_PORT=8000
CORS_ORIGINS=*
DEFAULT_USER_HANDLE=you

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://api:8000

# --- Claude Code capture hooks (used by cli/hooks) ---
# Point hooks at the API. Use localhost when running hooks on the host.
LIVESHORTLY_API_URL=http://localhost:8000
LIVESHORTLY_WEB_URL=http://localhost:3000
