# Copy to .env.selfhost. Never commit the filled-in file.
# No trailing slash. For a public deployment, use your own HTTPS origin.
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_SCHEME=http
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Generate TWO different values: openssl rand -hex 32
# Use a hex password so it is safe inside DATABASE_URL without URL escaping.
POSTGRES_PASSWORD=
SESSION_SECRET=

# Your own Google OAuth Web application credentials. Configure:
# Origin: PUBLIC_ORIGIN
# Redirect URI: PUBLIC_ORIGIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin is the users.is_admin column, not configuration. After your first
# sign-in: UPDATE users SET is_admin = true WHERE email = 'you@example.com';

# Optional Web Push for approval requests (see deploy/DEPLOY.md to generate).
# Empty disables it. Never commit a real key.
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:ops@example.com
VAPID_SUBJECT=
