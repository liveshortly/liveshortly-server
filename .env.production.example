# Production env for the liveshortly-app EC2 box (Cloudflare-proxied origin).
# Copy to `.env` on the server. NEXT_PUBLIC_* is baked at build time → rebuild web on change.
#
# This file holds only NON-SECRET, build-time config. The secrets — DATABASE_URL
# (Supabase), REDIS_URL (the redis box) and the Google OAuth values — go in
# `.env.auth`, written by the deploy workflow from GitHub secrets. Neither file
# is rsynced, so both survive deploys.

# --- API ---
# Public origin (Cloudflare terminates TLS; nginx proxies /api → api container)
CORS_ORIGINS=https://server.liveshortly.com,https://liveshortly.com
DEFAULT_USER_HANDLE=rsehgal

# --- Web (browser bundle, baked at build) ---
# Same-origin: the browser calls https://server.liveshortly.com/api/... which nginx routes.
NEXT_PUBLIC_API_URL=https://server.liveshortly.com
# Server-side (SSR) → api over the docker network.
API_INTERNAL_URL=http://api:8000

# --- Capture hooks (run on your laptop, pointed at the public API) ---
LIVESHORTLY_API_URL=https://server.liveshortly.com
LIVESHORTLY_WEB_URL=https://server.liveshortly.com
