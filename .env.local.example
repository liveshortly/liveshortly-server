# Local auth stack config — copy to .env.local and fill in the two Google
# secrets. Used by: docker compose --env-file .env.local -f docker-compose.yml
# -f docker-compose.local.yml up -d --build
#
# Get the client id + secret from Google Cloud Console → APIs & Services →
# Credentials → your OAuth 2.0 Client (Web application). In that client set:
#   Authorised JavaScript origins:  http://localhost:8080
#   Authorised redirect URIs:       http://localhost:8080/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Signs the ls_session cookie. Any long random string; regenerate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-byte-hex-string

# Postgres password for the local db (anything; it's a throwaway local volume).
POSTGRES_PASSWORD=liveshortly
