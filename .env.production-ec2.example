# Reference only — deploy-ec2-app.yml writes the real `.env` on the server on
# every run (DATABASE_URL from the DATABASE_URL repo secret, CORS/API URL
# derived from the workflow's `domain` input). This file just shows the
# expected shape, e.g. for testing docker-compose.prod-ec2.yml by hand.

# --- API ---
# Supabase pooler connection string (port 6543, transaction mode), same
# region as this box (us-west-1 / Supabase "West US (North California)").
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres
CORS_ORIGINS=https://nears.io,https://www.nears.io
DEFAULT_USER_HANDLE=rsehgal

# --- Web (browser bundle, baked at build) ---
NEXT_PUBLIC_API_URL=https://nears.io
API_INTERNAL_URL=http://api:8000
